# Copy to .env and fill in. Used by docker-compose.yml.

# The address the course will use. Its DNS must point at this server.
DOMAIN=kks.example.org

# The commander account, created on the first start (instead of the set-up screen).
# Change the password after the first login.
ADMIN_USERNAME=mefaked
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=מפקד הקורס

# Contact address sent to the browser push services with every phone notification.
PUSH_CONTACT=mailto:you@example.org

# Optional: "sign in with Google". Create an OAuth client (type: Web application)
# in Google Cloud Console with https://<DOMAIN> as an authorized JavaScript origin.
# Staff sign in with the Google account whose email is set on their user in Settings.
GOOGLE_CLIENT_ID=
# Optional: only accept accounts from this Google Workspace domain.
GOOGLE_HOSTED_DOMAIN=

# Optional
SESSION_DAYS=30
MAX_UPLOAD_MB=25
